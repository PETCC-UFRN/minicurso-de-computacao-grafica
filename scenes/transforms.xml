<PEinT>
  <canvas filename="transforms.png" size="800 400" />
  <!-- (a) referencia -->
  <polygon points="60 70 150 70 60 180" fill="120 160 220"/>

  <!-- (b) rotacao 45 no proprio eixo -->
  <polygon points="250 70 340 70 250 180" fill="220 120 160"/>
  <rotate deg="45"/>

  <!-- (c) ESPELHO horizontal: scale negativo -->
  <polygon points="470 70 560 70 470 180" fill="160 200 120"/>
  <scale by="-1 1"/>

  <!-- (d) COMPOSICAO: translada, depois gira (ordem importa) -->
  <polygon points="640 70 730 70 640 180" fill="200 160 100"/>
  <translate by="0 120"/>
  <rotate deg="30"/>

  <!-- (e) ORBITA: pivo externo (400 340) -->
  <circle radius="16" center="400 250" fill="30 30 30"/>

  <circle radius="16" center="400 250" fill="120 120 120"/>
  <rotate deg="120" pivot="400 340"/>

  <circle radius="16" center="400 250" fill="190 190 190"/>
  <rotate deg="240" pivot="400 340"/>
</PEinT>
